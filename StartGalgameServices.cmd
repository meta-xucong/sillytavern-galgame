@echo off
cd /d "%~dp0"
call StartGalgameConfigService.cmd || exit /b 1
call StartGalgameRuntimeBridge.cmd || exit /b 1
call StartGalgameVisualAssetService.cmd
powershell -NoProfile -ExecutionPolicy Bypass -Command "$checks=@(@{Name='game-config-service';Url='http://127.0.0.1:8791/v1/health';Json=$true},@{Name='original-runtime-bridge';Url='http://127.0.0.1:8795/health';Json=$true},@{Name='SillyTavern';Url='http://127.0.0.1:8001/';Json=$false}); foreach($check in $checks) { $ok=$false; $detail='unreachable'; foreach($attempt in 1..30) { try { $response=Invoke-WebRequest -UseBasicParsing -TimeoutSec 2 -Uri $check.Url; $ok=$response.StatusCode -eq 200; if($check.Json) { $body=$response.Content | ConvertFrom-Json; $ok=$ok -and $body.ok -eq $true; if($check.Name -eq 'original-runtime-bridge' -and $null -ne $body.ready) { $ok=$ok -and $body.ready -eq $true }; if($body.ok -eq $true -and $ok) { if($body.runtimeProof -and $body.runtimeProof.configured -eq $true) { $detail='healthy; runtime proof configured' } elseif($check.Name -eq 'original-runtime-bridge' -and $body.proofRequired -eq $true) { $detail='healthy; shared runtime proof configured by paired launcher' } else { $detail='healthy; proof status not configured' } } else { $detail='reachable but not healthy' } } else { if($ok) { $detail='reachable' } } } catch { }; if($ok) { break }; Start-Sleep -Milliseconds 300 }; if($ok) { Write-Host ($check.Name + ': ' + $detail) } else { Write-Warning ($check.Name + ': ' + $detail + '; story/visual acceptance remains unavailable and no local story fallback is used') } }"
